# =============================================
#  PoyberGallery — Environment Variables
#  Copy this file to ".env" and fill in your values
# =============================================

# Database
DB_HOST=localhost
DB_NAME=poybergallery
DB_USER=your_username
DB_PASS=your_password
DB_CHARSET=utf8mb4

# App
APP_NAME=PoyberGallery
APP_URL=http://localhost/PoyberGallery
APP_ENV=development

# Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,webp